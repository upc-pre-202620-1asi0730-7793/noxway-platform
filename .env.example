# Reference only: set these variables in IntelliJ or PowerShell. Spring does not load .env automatically.
DB_URL=jdbc:mysql://localhost:3306/noxway?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=noxway
DB_PASSWORD=replace-with-a-long-database-password
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
CORS_ORIGINS=http://localhost:4200
# SMTP is optional. Set SPRING_MAIL_HOST/PORT/USERNAME/PASSWORD in your environment.
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# NOXWAY_MAIL_FROM=noxway@your-domain.example
# NOXWAY_DELIVERY_WEBHOOK_URL=https://your-provider.example/messages
# NOXWAY_DELIVERY_WEBHOOK_SECRET=your-provider-secret
