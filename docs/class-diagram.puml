legend right
  |= Stereotype |= Classification |= Layer |
  |<back:#E3F2FD> <<aggregate>> </back> | Aggregate Root (Encapsulated) | Domain Layer |
  |<back:#E8F5E9> <<entity>> </back> | Domain Entity | Domain Layer |
  |<back:#FFF3E0> <<value object>> </back> | Tactical Value Object | Domain Layer |
  |<back:#FFF8E1> <<record>> </back> | Immutable Java Record (Command/Query/Resource) | Application / Interfaces |
  |<back:#F3E5F5> <<service>> </back> | Command / Query Service (CQRS) | Application Layer |
  |<back:#FCE4EC> <<repository>> </back> | Domain Repository Port | Domain Layer |
  |<back:#ECEFF1> <<adapter>> </back> | Infrastructure Adapter (JPA / Mail / Security) | Infrastructure Layer |
  |<back:#FFFDE7> <<controller>> </back> | REST Controller (/api/v1/*) | Interfaces Layer |
  |<back:#E0F7FA> <<facade>> </back> | Anti-Corruption Layer (ACL) | Interfaces / Application |
endlegend

' ============================================================
' 1. SHARED KERNEL (com.noctiva.noxway.shared)
' ============================================================
package "com.noctiva.noxway.shared" {
  package "domain" {
    abstract class "AbstractDomainAggregateRoot<T>" as AbstractDomainAggregateRoot <<aggregate>> {
      -domainEvents: List<Object>
      #registerEvent(event: Object): void
      +domainEvents(): List<Object>
      +clearDomainEvents(): void
    }

    class Coordinate <<value object>> {
      +latitude: double
      +longitude: double
      +distanceKmTo(lat: double, lng: double): double
    }

    class EmailAddress <<value object>> {
      +value: String
    }

    class TimeWindow <<value object>> {
      +start: String
      +end: String
    }
  }

  package "application.result" {
    interface "Result<T, E>" as Result <<record>> {
      +{static} success(value: T): Result<T, E>
      +{static} failure(error: E): Result<T, E>
    }

    interface ApplicationError <<record>> {
      +code(): String
      +message(): String
    }
  }

  package "infrastructure.persistence.jpa" {
    class OptimisticJpaSaveSupport <<adapter>> {
      +saveAndFlush(repo: JpaRepository, entity: E): E
    }
  }

  package "interfaces.rest" {
    class GlobalExceptionHandler <<controller>> {
      +handleValidation(ex: MethodArgumentNotValidException): ResponseEntity<ProblemDetail>
      +handleRuleViolation(ex: RuleViolation): ResponseEntity<ProblemDetail>
    }

    class ResponseEntityAssembler <<adapter>> {
      +toOk(result: Result, mapper: Function): ResponseEntity<?>
      +toCreated(result: Result, mapper: Function, locationFn: Function): ResponseEntity<?>
    }
  }
}

' ============================================================
' 2. IAM BOUNDED CONTEXT (com.noctiva.noxway.iam)
' ============================================================
package "com.noctiva.noxway.iam" {
  package "domain.model" {
    class AuthSession <<aggregate>> {
      -id: UUID
      -accountId: UUID
      -tokenHash: String
      -expiresAt: Instant
      -revoked: boolean
      -version: long
      +{static} create(accountId: UUID, tokenHash: String, expiresAt: Instant): AuthSession
      +revoke(): void
    }

    class PasswordResetToken <<aggregate>> {
      -id: UUID
      -accountId: UUID
      -tokenHash: String
      -expiresAt: Instant
      -used: boolean
      -version: long
      +{static} issue(accountId: UUID, tokenHash: String, expiresAt: Instant): PasswordResetToken
      +markUsed(): void
    }

    class Actor <<value object>> {
      +id: UUID
      +role: String
      +isStaff(): boolean
    }
  }

  package "interfaces" {
    interface IamContextFacade <<facade>> {
      +resolveCurrentActor(): Actor
      +isSecurityEnabled(): boolean
      +defaultWorkerId(): UUID
    }

    class AuthController <<controller>> {
      +status(): ResponseEntity<AuthStatusResource>
      +signIn(body: SignInResource): ResponseEntity<?>
      +signUp(body: SignUpResource): ResponseEntity<?>
      +signOut(): ResponseEntity<?>
      +passwordReset(body: PasswordResetRequestResource): ResponseEntity<?>
    }
  }
}

' ============================================================
' 3. PROFILES & TRUST NETWORK (com.noctiva.noxway.profiles)
' ============================================================
package "com.noctiva.noxway.profiles" {
  package "domain.model.aggregates" {
    class UserAccount <<aggregate>> {
      -id: UUID
      -email: String
      -passwordHash: String
      -fullName: String
      -phone: String
      -role: String
      -shiftType: String
      -shiftStart: String
      -shiftEnd: String
      -timeZone: String
      -active: boolean
      -version: long
      +{static} create(...): UserAccount
      +updateProfile(fullName: String, phone: String, shiftType: String, shiftStart: String, shiftEnd: String, timeZone: String): void
    }

    class TrustLink <<aggregate>> {
      -id: UUID
      -workerId: UUID
      -contactId: UUID
      -status: String
      -version: long
      +{static} invite(workerId: UUID, contactId: UUID): TrustLink
      +accept(actorId: UUID): void
      +reject(actorId: UUID): void
      +revoke(actorId: UUID): void
      +reInvite(): void
    }

    class NotificationPreference <<aggregate>> {
      -id: UUID
      -accountId: UUID
      -channel: String
      -enabled: boolean
      -priorityStart: String
      -priorityEnd: String
      -timeZone: String
      -version: long
      +update(enabled: boolean, start: String, end: String, tz: String): void
    }
  }

  package "domain.repositories" {
    interface UserAccountRepository <<repository>>
    interface TrustLinkRepository <<repository>>
    interface NotificationPreferenceRepository <<repository>>
  }

  package "application" {
    interface ProfileCommandService <<service>>
    interface ProfileQueryService <<service>>
  }

  package "interfaces" {
    interface ProfileDirectoryFacade <<facade>> {
      +findById(accountId: UUID): Optional<AccountSummary>
      +findByEmail(email: String): Optional<AccountSummary>
      +findActiveContactIdsForWorker(workerId: UUID): List<UUID>
      +findActiveWorkerIdsForContact(contactId: UUID): List<UUID>
    }
    class AccountsController <<controller>>
    class TrustLinksController <<controller>>
  }
}

' ============================================================
' 4. COMMUTING & COMPANION ALERTS (com.noctiva.noxway.commuting)
' ============================================================
package "com.noctiva.noxway.commuting" {
  package "domain.model.aggregates" {
    class Commute <<aggregate>> {
      -id: UUID
      -workerId: UUID
      -origin: String
      -destination: String
      -transport: String
      -startTime: Instant
      -estimatedArrivalTime: Instant
      -toleranceMinutes: int
      -arrivalTime: Instant
      -status: String
      -overdueAlertSent: boolean
      -version: long
      +{static} start(...): Commute
      +delay(additionalMinutes: int): void
      +markOverdue(): void
      +arrive(arrivedAt: Instant): void
    }

    class TelemetryPing <<aggregate>> {
      -id: UUID
      -commuteId: UUID
      -latitude: double
      -longitude: double
      -speed: double
      -recordedAt: Instant
      +{static} record(commuteId: UUID, lat: double, lng: double, speed: double, at: Instant): TelemetryPing
    }

    class SafetyIncident <<aggregate>> {
      -id: UUID
      -commuteId: UUID
      -workerId: UUID
      -type: String
      -description: String
      -status: String
      -resolvedAt: Instant
      -version: long
      +{static} report(commuteId: UUID, workerId: UUID, type: String, description: String): SafetyIncident
      +resolve(resolvedAt: Instant): void
    }

    class AlertNotification <<aggregate>> {
      -id: UUID
      -commuteId: UUID
      -incidentId: UUID
      -workerId: UUID
      -contactId: UUID
      -channel: String
      -message: String
      -status: String
      -attempts: int
      -version: long
      +markDelivered(at: Instant): void
      +markFailed(error: String, nextRetryAt: Instant): void
    }
  }

  package "application" {
    interface CommuteCommandService <<service>>
    interface CommuteQueryService <<service>>
  }

  package "interfaces" {
    interface CommuteVerificationFacade <<facade>> {
      +isArrivedCommuteOwnedByWorker(commuteId: UUID, workerId: UUID): boolean
    }
    class CommutingController <<controller>>
  }
}

' ============================================================
' 5. COMMUNITY & 24H MAP (com.noctiva.noxway.community)
' ============================================================
package "com.noctiva.noxway.community" {
  package "domain.model.aggregates" {
    class ServicePoint <<aggregate>> {
      -id: UUID
      -name: String
      -type: String
      -latitude: double
      -longitude: double
      -timeZone: String
      -status: String
      -trustScore: int
      -reportedBy: UUID
      -version: long
      +{static} submit(...): ServicePoint
      +updateDetails(...): void
      +applyModerationDecision(approved: boolean): void
      +recalculateTrustScore(score: int): void
    }

    class ServiceOpeningInterval <<aggregate>> {
      -id: UUID
      -serviceId: UUID
      -dayOfWeek: int
      -opensAt: String
      -closesAt: String
      -closesNextDay: boolean
      -open24Hours: boolean
    }

    class ServiceVote <<aggregate>> {
      -id: UUID
      -serviceId: UUID
      -accountId: UUID
      -direction: int
      -version: long
    }

    class RiskZone <<aggregate>> {
      -id: UUID
      -reportedBy: UUID
      -description: String
      -riskLevel: String
      -latitude: double
      -longitude: double
      -status: String
      -version: long
      +{static} report(...): RiskZone
      +resolve(): void
    }

    class RouteRating <<aggregate>> {
      -id: UUID
      -commuteId: UUID
      -workerId: UUID
      -score: int
      -comments: String
    }

    class CommunityPost <<aggregate>> {
      -id: UUID
      -authorId: UUID
      -title: String
      -content: String
      -district: String
      -category: String
      -latitude: Double
      -longitude: Double
      -createdAt: Instant
      -version: long
      +{static} create(authorId: UUID, title: String, content: String, district: String, category: String, lat: Double, lng: Double): CommunityPost
    }
  }

  package "application" {
    interface CommunityCommandService <<service>>
    interface CommunityQueryService <<service>>
  }

  package "interfaces" {
    interface CommunityTargetGovernanceFacade <<facade>>
    class CommunityController <<controller>>
  }
}

