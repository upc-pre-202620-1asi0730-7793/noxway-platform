' 6. WELLNESS & SLEEP (com.noctiva.noxway.wellness)
' ============================================================
package "com.noctiva.noxway.wellness" {
  package "domain.model.aggregates" {
    class RestSession <<aggregate>> {
      -id: UUID
      -workerId: UUID
      -startTime: Instant
      -endTime: Instant
      -durationMinutes: long
      -quality: int
      -notes: String
      -version: long
      +{static} log(workerId: UUID, start: Instant, end: Instant, quality: int, notes: String): RestSession
    }

    class SleepGoal <<aggregate>> {
      -workerId: UUID
      -targetMinutes: int
      -version: long
      +updateTarget(minutes: int): void
    }
  }

  package "application" {
    interface WellnessCommandService <<service>>
    interface WellnessQueryService <<service>>
  }

  package "interfaces" {
    class WellnessController <<controller>>
  }
}

' ============================================================
' 7. SUBSCRIPTIONS, OFFLINE PAYMENTS & REFERRALS (com.noctiva.noxway.subscriptions)
' ============================================================
package "com.noctiva.noxway.subscriptions" {
  package "domain.model.aggregates" {
    class SubscriptionPlan <<aggregate>> {
      -id: UUID
      -code: String
      -name: String
      -monthlyPrice: BigDecimal
      -maxContacts: int
      -maxWorkers: int
    }

    class Subscription <<aggregate>> {
      -id: UUID
      -ownerId: UUID
      -planId: UUID
      -status: String
      -startsAt: Instant
      -endsAt: Instant
      -version: long
      +activate(now: Instant): void
      +extendDays(days: int): void
      +cancel(): void
    }

    class SubscriptionMember <<aggregate>> {
      -id: UUID
      -subscriptionId: UUID
      -workerId: UUID
      -status: String
      -version: long
      +accept(): void
      +reject(): void
      +revoke(): void
    }

    class SubscriptionPayment <<aggregate>> {
      -id: UUID
      -subscriptionId: UUID
      -workerId: UUID
      -amount: BigDecimal
      -currency: String
      -status: String
      -reference: String
      -version: long
      +confirmOffline(reference: String, confirmedBy: UUID): void
      +reject(rejectedBy: UUID): void
    }

    class CollectiveBenefit <<aggregate>>
    class BenefitClaim <<aggregate>>
    class ReferralCode <<aggregate>>
    class ReferralRedemption <<aggregate>>
    class ReferralReward <<aggregate>>
  }

  package "interfaces" {
    interface SubscriptionAllowanceFacade <<facade>> {
      +maxAllowedContactsForWorker(workerId: UUID): int
    }
    class SubscriptionsController <<controller>>
  }
}

' ============================================================
' 8. MODERATION & GOVERNANCE (com.noctiva.noxway.moderation)
' ============================================================
package "com.noctiva.noxway.moderation" {
  package "domain.model.aggregates" {
    class ModerationReport <<aggregate>> {
      -id: UUID
      -targetType: String
      -targetId: UUID
      -reporterId: UUID
      -reason: String
      -status: String
      -version: long
      +decide(approved: boolean): void
    }

    class ModerationAction <<aggregate>> {
      -id: UUID
      -reportId: UUID
      -moderatorId: UUID
      -decision: String
      -notes: String
      -decidedAt: Instant
    }
  }

  package "interfaces" {
    interface ModerationQueueFacade <<facade>>
    class ModerationController <<controller>>
  }
}

' Relationships across Bounded Contexts via ACL Facades
AccountsController --> ProfileCommandService
AccountsController --> ProfileQueryService
TrustLinksController --> ProfileCommandService
CommutingController --> CommuteCommandService
CommutingController --> CommuteQueryService
CommunityController --> CommunityCommandService
CommunityController --> CommunityQueryService
CommunityController --> ProfileDirectoryFacade
WellnessController --> WellnessCommandService
WellnessController --> WellnessQueryService
SubscriptionsController --> ProfileDirectoryFacade
ModerationController --> CommunityTargetGovernanceFacade
ProfileCommandService ..> SubscriptionAllowanceFacade : verifies contact allowance
CommunityCommandService ..> CommuteVerificationFacade : verifies arrived commute
CommunityCommandService ..> ModerationQueueFacade : queues service/risk for review
CommuteCommandService ..> ProfileDirectoryFacade : resolves active trusted contacts

@enduml
