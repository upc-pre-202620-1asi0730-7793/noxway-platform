{
  "info": {
    "name": "Noxway Platform API (/api/v1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "actorId",
      "value": "00000000-0000-0000-0000-000000000101"
    },
    {
      "key": "adminId",
      "value": "00000000-0000-0000-0000-000000000901"
    },
    {
      "key": "contactId",
      "value": "00000000-0000-0000-0000-000000000201"
    },
    {
      "key": "commuteId",
      "value": ""
    },
    {
      "key": "trustLinkId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "IAM status (deferred)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/status"
      }
    },
    {
      "name": "Account directory",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/accounts/directory",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ]
      }
    },
    {
      "name": "My account",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/accounts/me",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ]
      }
    },
    {
      "name": "Invite registered contact",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/trust-links",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contactEmail\": \"miguel.quispe@noxway.pe\"\n}"
        }
      }
    },
    {
      "name": "List trust links",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/trust-links",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ]
      }
    },
    {
      "name": "Accept as contact",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/trust-links/{{trustLinkId}}/accept",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{contactId}}"
          }
        ]
      }
    },
    {
      "name": "List commutes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/commutes",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ]
      }
    },
    {
      "name": "Confirm arrival",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/commutes/{{commuteId}}/arrive",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ]
      }
    },
    {
      "name": "Available services",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/community/services?openOnly=true",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ]
      }
    },
    {
      "name": "Rest summary",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/wellness/summary?timeZone=America/Lima",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{actorId}}"
          }
        ]
      }
    },
    {
      "name": "Plans",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/plans"
      }
    },
    {
      "name": "Companion alerts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/companion/alerts",
        "header": [
          {
            "key": "X-Actor-Id",
            "value": "{{contactId}}"
          }
        ]
      }
    }
  ]
}
